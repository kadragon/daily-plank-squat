{
  "name": "daily-plank-squat",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:cf": "bun run build && bunx wrangler dev",
    "deploy": "bun run build && bunx wrangler deploy",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome lint .",
    "typecheck": "bunx tsc --noEmit",
    "check:no-focused-tests": "bash scripts/check-no-focused-tests.sh",
    "check:merge-conflicts": "bash scripts/check-merge-conflicts.sh",
    "precommit": "bun run lint && bun run typecheck && bun run test && bun run check:no-focused-tests && bun run check:merge-conflicts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.11.1",
    "lefthook": "^2.1.10",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "overrides": {
    "vite": "^8.0.14"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
